# =============================================================================
# Flicklet — repo-root local environment (copy to `.env`, fill in real values)
# =============================================================================
# Used by: `npx netlify dev` (injects into Netlify Functions + Vite via Netlify)
# Do not commit `.env`. See `apps/web/.env.example` for frontend-only overrides.
# =============================================================================

# --- Required for search / TMDB proxy (server) ---
# TMDB v4 Read Access Token (https://www.themoviedb.org/settings/api)
TMDB_TOKEN=your_tmdb_v4_read_access_token

# --- Frontend (embedded at build/dev time; safe to expose in client bundle) ---
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: direct TMDB from browser (extras); search uses server proxy by default
VITE_TMDB_KEY=your_tmdb_v3_or_v4_key

# Optional: local site URL for auth redirects / share links
# VITE_PUBLIC_BASE_URL=http://localhost:8888

# Optional: FCM web push (if testing notifications)
# VITE_FCM_VAPID_KEY=your_web_push_vapid_key

# Optional: Google Sign-In (Capacitor / web)
# VITE_GOOGLE_WEB_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# Optional: extras (YouTube bloopers pipeline)
# VITE_YOUTUBE_API_KEY=your_youtube_data_api_key

# Optional: billing API base (defaults to same-origin /api when empty)
# VITE_API_BASE_URL=

# --- Netlify Functions (server-only; optional unless testing that feature) ---
# SENDGRID_API_KEY=your_sendgrid_api_key
# SENDGRID_FROM=noreply@yourdomain.app
# SENDGRID_REPLY_TO=support@yourdomain.app
# FEEDBACK_EMAIL=feedback@yourdomain.app
# FROM_EMAIL=noreply@yourdomain.app

# Goofs admin ingest (goofs-fetch)
# GOOFS_INGESTION_ADMIN_TOKEN=your_long_random_admin_token
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Billing validate (Google Play)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Dictionary proxy (if enabled)
# WORDNIK_API_KEY=your_wordnik_api_key

# Auth debug only (local)
# VITE_BYPASS_USERNAME=
# VITE_AUTH_DEFAULT_POPUP=1
# FLK_AUTH_DEBUG=1
