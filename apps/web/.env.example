# =============================================================================
# Flicklet — frontend-only local overrides (copy to `apps/web/.env`)
# =============================================================================
# Used when running Vite from `apps/web` without Netlify CLI.
# For normal local dev, prefer repo-root `.env` + `npx netlify dev` from repo root.
# Only VITE_* belong here — never put server secrets (TMDB_TOKEN, SENDGRID_*, etc.).
# =============================================================================

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

VITE_TMDB_KEY=your_tmdb_v3_or_v4_key

# VITE_PUBLIC_BASE_URL=http://localhost:8888
# VITE_FCM_VAPID_KEY=your_web_push_vapid_key
# VITE_GOOGLE_WEB_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com
# VITE_YOUTUBE_API_KEY=your_youtube_data_api_key
# VITE_API_BASE_URL=
# VITE_BYPASS_USERNAME=
# VITE_AUTH_DEFAULT_POPUP=1
