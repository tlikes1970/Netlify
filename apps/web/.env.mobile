# Mobile build configuration
# This file is used when building with --mode mobile
# Sets API_BASE to production backend URL for Capacitor Android/iOS builds

VITE_API_BASE_URL=https://flicklet.netlify.app

# TMDB proxy base URL - must be absolute for Android WebView
# Defaults to /api/tmdb-proxy for web builds (works with Netlify redirects)
# For mobile, must be absolute URL to hit Netlify function directly
VITE_TMDB_PROXY_BASE=https://flicklet.netlify.app/api/tmdb-proxy
