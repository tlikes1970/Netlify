rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token != null
        && request.auth.token.role == 'admin';
    }

    // Users and per-user subcollections (library sync, settings, tabs, notifications, billing)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);

      match /settings/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /tabState/{tabKey} {
        allow read, write: if isOwner(userId);
      }

      match /notificationSettings/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /episodeProgress/{showId} {
        allow read, write: if isOwner(userId);
      }

      match /billing/{docId} {
        allow read: if isOwner(userId);
        allow write: if isAdmin();
      }
    }

    // Username claiming
    match /usernames/{handle} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(handle));
      allow delete: if isAuthenticated()
        && resource.data.uid == request.auth.uid;
    }

    // Goofs / insights (client read for signed-in users; writes via admin/functions)
    match /insights/{tmdbId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Admin access to remaining collections (e.g. titles, diagnostics)
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
