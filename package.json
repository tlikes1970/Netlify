{
  "name": "flicklet-tv-tracker",
  "version": "28.170.7",
  "description": "Flicklet - TV & Movie Tracker",
  "private": true,
  "scripts": {
    "dev": "netlify dev",
    "build": "npm run build --prefix apps/web",
    "preview": "npm run preview --prefix apps/web",
    "typecheck": "npm run typecheck --prefix apps/web",
    "lint": "npm run lint --prefix apps/web",
    "test": "npm run test --prefix apps/web",
    "test:e2e": "npm run test:e2e --prefix apps/web",
    "functions:build": "npm run build --prefix functions",
    "web:build": "npm run build --prefix apps/web",
    "mobile:build": "npm run build --prefix apps/web -- --mode mobile",
    "mobile:sync": "npm run mobile:build && npx cap copy && npx cap sync",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "audit:dup": "jscpd --threshold 0 --format markdown,json --output reports/jscpd .",
    "audit:dead": "depcheck apps/web && knip",
    "lint:strict": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky install"
  },
  "dependencies": {
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@playwright/test": "^1.55.0",
    "dotenv": "^16.3.1",
    "netlify-cli": "^23.11.0",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "axe-core": "^4.10.3",
    "depcheck": "^0.4.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-sonarjs": "^0.23.0",
    "eslint-plugin-unicorn": "^50.0.1",
    "fast-glob": "^3.3.3",
    "htmlparser2": "^10.0.0",
    "husky": "^9.1.7",
    "jscpd": "^3.5.10",
    "knip": "^5.66.3",
    "lighthouse": "^13.0.1",
    "lint-staged": "^16.1.6",
    "picocolors": "^1.1.1",
    "postcss": "^8.5.6",
    "postcss-safe-parser": "^7.0.1",
    "prettier": "^3.6.2",
    "sharp": "^0.34.5",
    "source-map-explorer": "^2.5.3",
    "terser": "^5.44.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "webpack-bundle-analyzer": "^4.10.2"
  },
  "keywords": [
    "tv",
    "movie",
    "tracker",
    "pwa",
    "entertainment"
  ],
  "author": "Flicklet Team",
  "license": "MIT"
}
